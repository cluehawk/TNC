@ECHO OFF
REM Compile and run the deterministic core-rule regression tests.
REM Run this from the project root or from BUILD\ under Windows.

IF EXIST ..\SRC\TNCTEST.PAS GOTO TESTROOT
IF EXIST SRC\TNCTEST.PAS GOTO TESTLOCAL
ECHO Could not find SRC\TNCTEST.PAS
EXIT /B 1

:TESTROOT
CD ..
CD SRC
GOTO RUNTESTS

:TESTLOCAL
CD SRC

:RUNTESTS
IF EXIST TNCTEST.EXE DEL TNCTEST.EXE
IF EXIST TNCTEST.OUT DEL TNCTEST.OUT
ECHO Building TNCTEST.EXE with Turbo Pascal 7...
MSDOS.exe ..\BIN\TPC /B /M /$G- /$R- /$S- TNCTEST.PAS
IF ERRORLEVEL 1 EXIT /B 1

ECHO Running core-rule regression tests...
MSDOS.exe TNCTEST.EXE
SET TESTRESULT=%ERRORLEVEL%
IF EXIST TNCTEST.OUT TYPE TNCTEST.OUT
IF EXIST TNCTEST.EXE DEL TNCTEST.EXE
IF EXIST TNCTEST.OUT DEL TNCTEST.OUT
EXIT /B %TESTRESULT%
